{
  "family": "r4c-worker",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "1024",
  "memory": "2048",
  "runtimePlatform": { "operatingSystemFamily": "LINUX", "cpuArchitecture": "X86_64" },
  "executionRoleArn": "arn:aws:iam::<account-id>:role/request-4-change-worker-exec",
  "taskRoleArn": "arn:aws:iam::<account-id>:role/request-4-change-worker-task",
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "ghcr.io/foolswithtools/request-4-change-worker@sha256:dd9c2aa3dd4f91371ba2c164f0757029825534d1a792a2fb0a6b9e635be70d67",
      "essential": true,
      "command": ["run"],
      "environment": [
        { "name": "ANTHROPIC_MODEL", "value": "<bedrock-inference-profile-id>" },
        { "name": "R4C_EGRESS_PROXY_URL", "value": "http://egress-proxy.internal.example.com:3128" },
        { "name": "OTEL_EXPORTER_OTLP_ENDPOINT", "value": "http://otel-collector.internal.example.com:4318" },
        { "name": "OTEL_SDK_DISABLED", "value": "false" },
        { "name": "R4C_DEPLOYMENT_ENVIRONMENT", "value": "production" },
        { "name": "R4C_INSTANCE", "value": "example" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/request-4-change-worker",
          "awslogs-region": "<region>",
          "awslogs-stream-prefix": "worker"
        }
      }
    }
  ]
}
