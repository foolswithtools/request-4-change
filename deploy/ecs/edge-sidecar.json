[
  {
    "name": "edge",
    "image": "ghcr.io/foolswithtools/request-4-change-server@sha256:56e4d4327bb32003571d70cce66bdf89c5f35e2a0259da26776aee00f61a3cb4",
    "essential": true,
    "command": ["--role=edge"],
    "portMappings": [{ "containerPort": 8090, "protocol": "tcp", "name": "r4c-edge" }],
    "environment": [
      { "name": "R4C_PORT", "value": "8090" },
      { "name": "R4C_APP_ID", "value": "example-app" },
      { "name": "R4C_HOST_JWKS_URL", "value": "https://app.example.com/.well-known/jwks.json" },
      { "name": "R4C_CONTROL_URL", "value": "https://r4c.example.com" },
      { "name": "OTEL_EXPORTER_OTLP_ENDPOINT", "value": "https://otlp.example.com" },
      { "name": "OTEL_SDK_DISABLED", "value": "false" },
      { "name": "R4C_DEPLOYMENT_ENVIRONMENT", "value": "production" },
      { "name": "R4C_INSTANCE", "value": "example" }
    ],
    "healthCheck": {
      "command": ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:8090/__r4c/healthz || exit 1"],
      "interval": 30,
      "timeout": 5,
      "retries": 3,
      "startPeriod": 10
    },
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/example-app",
        "awslogs-region": "<region>",
        "awslogs-stream-prefix": "edge"
      }
    }
  }
]
