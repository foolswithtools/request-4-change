{
  "family": "r4c-egress",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": { "operatingSystemFamily": "LINUX", "cpuArchitecture": "X86_64" },
  "executionRoleArn": "arn:aws:iam::<account-id>:role/request-4-change-egress-exec",
  "containerDefinitions": [
    {
      "name": "egress-proxy",
      "image": "ghcr.io/foolswithtools/request-4-change-worker@sha256:dd9c2aa3dd4f91371ba2c164f0757029825534d1a792a2fb0a6b9e635be70d67",
      "essential": true,
      "entryPoint": ["node", "/app/egress-proxy.cjs"],
      "user": "10001:10001",
      "portMappings": [{ "containerPort": 3128, "protocol": "tcp" }],
      "environment": [
        { "name": "R4C_CONTROL_INTERNAL_URL", "value": "http://control.internal.example.com:8081" }
      ],
      "secrets": [
        { "name": "R4C_PROXY_KEY", "valueFrom": "arn:aws:secretsmanager:<region>:<account-id>:secret:<egress-proxy-key>" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/r4c-egress",
          "awslogs-region": "<region>",
          "awslogs-stream-prefix": "egress-proxy"
        }
      }
    }
  ]
}
